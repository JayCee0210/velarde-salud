# ============================================================
# VELARDE DIGITAL — Plantilla de variables de entorno
#
# INSTRUCCIONES:
# 1. Copia este archivo a `.env.local` (git ignorará ese archivo).
# 2. Reemplaza los valores de ejemplo con los reales de tu
#    proyecto en Supabase (Settings → API).
# 3. NUNCA subas `.env.local` ni sus valores reales a Git.
# ============================================================

# --- Supabase: cliente (públicos, expuestos en el navegador) ---
# Se usan en el cliente de Next.js. NO confiar en ellos para
# proteger datos: la seguridad real la da RLS en Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tu-anon-key-aqui

# --- Supabase: solo servidor (PRIVADO) ---
# Clave service_role: BYPASSA RLS. Úsola SOLO en Route Handlers /
# Server Actions / API routes de Next.js (lado servidor).
# Nunca la expongas con prefijo NEXT_PUBLIC_ ni la registres
# en el cliente. Solo va en `.env.local`, no en Git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tu-service-role-key-aqui
